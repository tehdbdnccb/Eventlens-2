API_PORT=4000
WEB_PORT=5173
# demo = simulated data/execution; false = live Somnia adapter
DEMO_MODE=true
SOMNIA_NETWORK=shannon
# Defaults are selected from SOMNIA_NETWORK; leave blank unless overriding.
SOMNIA_INDEXER_URL=
